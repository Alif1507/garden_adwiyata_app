{
  "name": "smart-garden-firebase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-smart-garden --only auth,database",
    "seed": "node ./scripts/seed-emulators.mjs",
    "test": "firebase emulators:exec --project demo-smart-garden --only auth,database \"node ./scripts/seed-emulators.mjs && node --test ./test/database.rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-tools": "15.29.0"
  },
  "engines": {
    "node": ">=20"
  }
}
